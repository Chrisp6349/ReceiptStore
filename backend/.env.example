# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000

# Signs customer JWTs. Use a long random string in any real deployment.
JWT_SECRET=dev-only-change-me

# Shared secret the Demo Till sends on every request. Stands in for proper
# device/service auth, which is out of scope for Prototype 001.
TILL_API_KEY=dev-till-key-change-me

# Comma-separated list of origins allowed to call the API (the customer app
# and till app dev servers).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
